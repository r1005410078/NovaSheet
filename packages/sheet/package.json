{
  "name": "@novasheet/sheet",
  "version": "0.1.0",
  "description": "Default NovaSheet browser spreadsheet assembly.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://r1005410078.github.io/NovaSheet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r1005410078/NovaSheet.git",
    "directory": "packages/sheet"
  },
  "bugs": {
    "url": "https://github.com/r1005410078/NovaSheet/issues"
  },
  "keywords": [
    "spreadsheet",
    "grid",
    "canvas",
    "data-grid",
    "typescript",
    "ai-native"
