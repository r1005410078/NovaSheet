{
  "name": "novasheet",
  "version": "0.0.0",
  "private": true,
  "description": "High-performance Canvas spreadsheet engine for AI-native data workbenches.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "homepage": "https://r1005410078.github.io/NovaSheet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r1005410078/NovaSheet.git"
  },
  "bugs": {
    "url": "https://github.com/r1005410078/NovaSheet/issues"
  },
  "keywords": [
    "spreadsheet",
    "grid",
    "canvas",
    "data-grid",
    "ai-native",
    "typescript",
    "workbench"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run typecheck && bun run --filter @novasheet/core build && bun run --filter @novasheet/canvas2d build && bun run --filter @novasheet/react build && bun run --filter @novasheet/cell-kit build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run lint:architecture && bun run lint:react-boundary && bun run lint:cellkit-boundary && bun run lint:mbd && bun run lint:scenario-coverage && oxlint packages",
    "lint:architecture": "bun scripts/check-kernel-boundary.ts",
    "lint:react-boundary": "bun scripts/check-react-boundary.ts",
    "lint:cellkit-boundary": "bun scripts/check-cellkit-boundary.ts",
    "lint:mbd": "bun run --filter @novasheet/mbd mbd validate",
    "lint:scenario-coverage": "bun run --filter @novasheet/react lint:scenario-coverage",
    "format": "prettier --write --cache --log-level warn \"**/*.{ts,tsx,js,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run lint && bun run typecheck && bun test && bun run build && changeset publish",
    "storybook": "bun run --filter @novasheet/storybook storybook",
    "build-storybook": "bun run --filter @novasheet/storybook build-storybook",
    "sync:mbd-manifest": "bun run --filter @novasheet/mbd mbd manifest"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxlint": "^1.66.0",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3"
  }
}
