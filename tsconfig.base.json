{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@zhiguang/novasheet-core": ["./packages/core/src/index.ts"],
      "@zhiguang/novasheet-canvas2d": ["./packages/canvas2d/src/index.ts"],
      "@zhiguang/novasheet-react": ["./packages/react/src/index.ts"],
      "@zhiguang/novasheet-mbd": ["./packages/mbd/src/index.ts"],
      "@zhiguang/novasheet-cell-kit": ["./packages/cell-kit/src/index.ts"],
      "@/*": ["./packages/react/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  }
}
